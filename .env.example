# Keep OpenAI as the safe default until Mistral is configured in Vercel.
AI_PROVIDER=openai
# Optional override. Leave blank to use the selected provider's default model.
AI_MODEL=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# Server-side Voxtral TTS. Set false for an immediate browser-only fallback.
TTS_ENABLED=true
# Optional override; defaults to voxtral-mini-tts-2603.
TTS_MODEL=
